{
  "name": "unitys-workshop",
  "private": true,
  "version": "1.0.0",
  "description": "Static card creator and gallery for Sentinels of the Multiverse",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python3 -m unittest discover -s tests/python -p 'test_*.py' -v",
    "test:all": "npm test && npm run test:python",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jquery": "3.6.0",
    "jsdom": "26.1.0",
    "vitest": "^4.1.11"
  }
}
